{
  "name": "@relay/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Relay Chat для Windows, Linux и macOS",
  "author": "Relay Chat contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.relay.chat",
    "productName": "Relay Chat",
    "directories": {
      "output": "../../release/desktop"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "web/**/*"
    ],
    "beforePack": "./copy-web.cjs",
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  }
}

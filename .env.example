# Для локальной разработки переменные можно не задавать: встроенный PostgreSQL (PGlite).
# В Docker .env читается compose.yaml. Сервер сам читает корневой .env при запуске через npm.
PORT=3001
DB_DRIVER=pglite
PGLITE_DIR=./data/relay
# DATABASE_URL=postgres://relay:CHANGE_ME@localhost:5432/relay
# REDIS_URL=redis://localhost:6379
# ELASTICSEARCH_URL=http://localhost:9200
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://localhost:3001,http://127.0.0.1:3001,capacitor://localhost,http://localhost,https://localhost,relay://app
SESSION_DAYS=7
MESSAGE_RATE_LIMIT=120
MESSAGE_RATE_WINDOW_MS=10000
API_RATE_LIMIT=3000
POSTGRES_PASSWORD=replace_with_long_random_password
WEB_PORT=8080
# В мобильном/десктопном приложении адрес сервера задаётся на экране входа.
# HTTP по IP разрешён в учебной сборке Android. Для открытого интернета используйте HTTPS.
